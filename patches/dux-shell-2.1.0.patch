diff --git a/Modules/Dock/GlassDockFinish.qml b/Modules/Dock/GlassDockFinish.qml
new file mode 100644
index 0000000..c2937f7
--- /dev/null
+++ b/Modules/Dock/GlassDockFinish.qml
@@ -0,0 +1,23 @@
+import QtQuick
+
+ShaderEffect {
+    required property real cornerRadius
+    required property real flareWidth
+    required property real flareHeight
+
+    required property color topTint
+    required property color bottomTint
+    required property color rimTint
+    required property real topOpacity
+    required property real bottomOpacity
+
+    readonly property real widthPx: width
+    readonly property real heightPx: height
+
+    // ShaderEffect premultiplies color uniforms. The shader controls opacity separately.
+    readonly property vector3d glassTopRgb: Qt.vector3d(topTint.r, topTint.g, topTint.b)
+    readonly property vector3d glassBottomRgb: Qt.vector3d(bottomTint.r, bottomTint.g, bottomTint.b)
+    readonly property vector3d glassRimRgb: Qt.vector3d(rimTint.r, rimTint.g, rimTint.b)
+
+    fragmentShader: Qt.resolvedUrl("../../Shaders/qsb/redock.frag.qsb")
+}
